# Default: normalize to LF in the repo
* text=auto eol=lf

# Explicit text files
*.dart    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.arb     text eol=lf
*.gradle  text eol=lf
*.kts     text eol=lf
*.properties text eol=lf
*.xml     text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.py      text eol=lf

# Binary files — never touch
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.jks     binary
*.keystore binary
*.aab     binary
*.apk     binary
*.jar     binary
*.so      binary
*.dll     binary
*.exe     binary
*.zip     binary
